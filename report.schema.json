{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "week",
    "generated_at",
    "timezone",
    "games"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "const": "Asia/Taipei"
    },
    "games": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sections",
          "sources"
        ],
        "properties": {
          "name": {
            "enum": [
              "原神",
              "絕區零",
              "鳴潮",
              "明日方舟：終末地",
              "崩壞：星穹鐵道"
            ]
          },
          "sections": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "ending_events",
              "banners",
              "upcoming",
              "login",
              "free_rewards",
              "materials",
              "changes",
              "codes",
              "entries"
            ],
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "ending_events": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "banners": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "upcoming": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "login": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "free_rewards": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "materials": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "changes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "codes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "entries": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "url"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://",
                  "maxLength": 2048
                }
              }
            }
          }
        }
      }
    }
  }
}